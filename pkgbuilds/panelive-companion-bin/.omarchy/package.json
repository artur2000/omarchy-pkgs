{
  "source": "local",
  "channels": ["edge"],
  "upstream": {
    "watch": {
      "github": "Clownfish-Web/panelive-companion",
      "allow_prerelease": true,
      "pattern": "v(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)-?(?P<suffix>(?:(?:alpha|beta|rc)\\.[0-9]+)?)",
      "version": "{version}{suffix}",
      "variables": {
        "_tag": "{tag}"
      }
    }
  }
}
